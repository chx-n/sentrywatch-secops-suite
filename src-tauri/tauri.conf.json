{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentryWatch SecOps Suite",
  "version": "0.1.0",
  "identifier": "com.sentrywatch.secops",
  "build": {
    "beforeDevCommand": "pnpm run web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SentryWatch SecOps Suite",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {},
    "process": {}
  }
}
